# Backblaze B2 application key (create a key scoped to B2_BUCKET with
# read/write/delete access). These values are fake examples only.
B2_KEY_ID=0000000000000000000000001

# Application key secret that belongs to B2_KEY_ID.
B2_APP_KEY=K0000000000000000000000000000000

# S3-compatible endpoint of the bucket (the "S3 Endpoint" shown in the B2
# bucket details).
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Region of that endpoint.
B2_REGION=us-west-004

# Bucket that holds the shared files. Each user's files go under u/<user id>/.
B2_BUCKET=example-file-bucket

# HTTP port the server listens on. Defaults to 8080 when unset.
PORT=8080

# SQLite database for accounts, sessions and storage usage. Defaults to
# shortened.db in the working directory; the Docker image uses
# /data/shortened.db, so mount a volume on /data.
DB_PATH=shortened.db

# Storage each user may use, in megabytes. Defaults to 500.
QUOTA_MB=500

# Maximum number of accounts. 0 (the default) means no limit. Sign-up is open
# to anyone, so this caps how many strangers can use your bucket.
MAX_USERS=0

# Session cookies are marked Secure (HTTPS only) unless this is "false".
# Chrome and Firefox accept Secure cookies on http://localhost; Safari does
# not, so set this to false for local testing in Safari only.
COOKIE_SECURE=true

# Set to "true" only when the server sits behind a reverse proxy that appends
# the client address to X-Forwarded-For. Rate limiting then uses that address.
TRUST_PROXY=false

# HTTPS for the server itself, e.g. so a CDN reaches the origin encrypted.
# Set both to PEM file paths (certificate chain, then private key) to serve
# HTTPS (TLS 1.2 or newer) on PORT. Leave both empty for plain HTTP. Setting
# only one is an error and the server will not start.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Mail (sign-up codes, email changes, password resets). One of these is
# required, or the server will not start.
# MAIL_FROM: send through Amazon SES as this address. Credentials come from the
# default AWS chain (on EC2, the instance role). SES_REGION defaults to us-east-1.
MAIL_FROM=
SES_REGION=us-east-1
# MAIL_LOG=true: no SES; each mail, code included, is written to the server
# log. For local runs and CI only. Ignored when MAIL_FROM is set.
MAIL_LOG=true
