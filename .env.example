# Backblaze B2 application key (create a key scoped to B2_BUCKET with
# read/write access). These values are fake examples only.
B2_KEY_ID=0000000000000000000000001

# Application key secret that belongs to B2_KEY_ID.
B2_APP_KEY=K0000000000000000000000000000000

# S3-compatible endpoint of the bucket (the "S3 Endpoint" shown in the B2
# bucket details).
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Region of that endpoint.
B2_REGION=us-west-004

# Bucket that holds the shared files.
B2_BUCKET=example-file-bucket

# Shared secret clients send in the X-API-Key header. Use a long random value.
API_KEY=example-api-key-please-replace

# HTTP port the API listens on. Defaults to 8080 when unset.
PORT=8080

# Origin allowed to call the API from a browser (scheme + host + port, no path).
ALLOWED_ORIGIN=http://localhost:8000
